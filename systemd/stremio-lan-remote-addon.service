[Unit]
Description=Stremio LAN Remote Addon (port 7000)
After=network-online.target

[Service]
Type=simple
# Single source of truth for the addon. Runs node inside the stremio-build
# distrobox via the wrapper (which also ensures the container is up + supplies
# env/token). launch-stremio.sh starts THIS unit instead of spawning its own
# addon, so there is never a second instance fighting over port 7000.
ExecStart=%h/dev/stremio-lan-remote/scripts/run-addon.sh
Restart=on-failure
RestartSec=5s

[Install]
WantedBy=default.target
